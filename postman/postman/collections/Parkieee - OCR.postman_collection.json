          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Kosongkan token lama setiap kali login ulang",
                  "pm.collectionVariables.set('token', '');"
                ],
                "id": "74d3b163-3e70-4566-9580-a483c9da7373"
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login berhasil - status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Response punya token', () => pm.expect(json.data).to.have.property('token'));",
                  "",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "  console.log('✅ Token berhasil disimpan');",
                  "} else {",
                  "  console.error('❌ Token tidak ditemukan di response');",
                  "}"
                ],
                "id": "621bde3e-24d9-4c3a-8937-993affdc7e59"
              }
            }
          ],
          "id": "7783bae6-47ae-47fc-a8dc-9eb25df4de0f",
          "request": {
