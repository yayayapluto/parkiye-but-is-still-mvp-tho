        {
          "name": "Polling: Tunggu vehicle_id terisi (OCR async)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Helper polling: cek apakah vehicle_id sudah terisi",
                  "// Jalankan manual beberapa kali setelah entry dengan foto,",
                  "// atau gunakan Collection Runner dengan delay antar request",
                  "",
                  "const txId  = pm.collectionVariables.get('tx_id');",
                  "const base  = pm.collectionVariables.get('baseUrl');",
                  "const token = pm.collectionVariables.get('token');",
                  "",
                  "if (!txId) throw new Error('❌ tx_id belum ada');",
                  "",
                  "// Cek sekali via sendRequest sebelum request utama jalan",
                  "pm.sendRequest({",
                  "  url: `${base}/transactions/${txId}`,",
                  "  method: 'GET',",
                  "  header: { Authorization: 'Bearer ' + token }",
                  "}, (err, res) => {",
                  "  if (err) return;",
                  "  const vehicleId = res.json().data?.vehicle_id;",
                  "  if (vehicleId) {",
                  "    console.log('✅ vehicle_id sudah terisi:', vehicleId, '— OCR selesai!');",
                  "    pm.collectionVariables.set('vehicle_id_from_ocr', vehicleId);",
                  "  } else {",
                  "    console.log('⏳ vehicle_id belum terisi — OCR masih berjalan atau foto tidak diupload');",
                  "  }",
                  "});"
                ],
                "id": "16bc2e29-09f6-43c0-a3de-f34c8e056251"
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json().data;",
                  "",
                  "// Soft assertion: vehicle_id mungkin belum terisi jika OCR masih running",
                  "if (d.vehicle_id) {",
                  "  pm.test('✅ vehicle_id terisi (OCR berhasil link kendaraan)', () => {",
                  "    pm.expect(d.vehicle_id).to.be.a('string');",
                  "  });",
                  "  pm.collectionVariables.set('vehicle_id_from_ocr', d.vehicle_id);",
                  "  console.log('vehicle_id:', d.vehicle_id);",
                  "} else {",
                  "  console.warn('⚠️ vehicle_id masih null — OCR belum selesai atau foto tidak diupload. Coba lagi setelah beberapa detik.');",
                  "}"
                ],
                "id": "b7f567af-6e8f-4edd-8fe9-422618036cb7"
              }
            }
          ],
          "id": "9ccf81c1-7d73-43ff-9dc4-eba33235d323",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
