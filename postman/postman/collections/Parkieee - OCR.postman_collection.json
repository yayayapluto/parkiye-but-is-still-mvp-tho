                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json().data;",
                  "pm.test('ID sesuai', () => pm.expect(d.id).to.eql(pm.collectionVariables.get('tx_id')));",
                  "pm.test('Status masih open', () => pm.expect(d.status).to.eql('open'));",
                  "",
                  "// Cek apakah OCR sudah selesai link vehicle",
                  "if (d.vehicle_id) {",
