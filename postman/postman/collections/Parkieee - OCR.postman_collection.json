        {
          "name": "Ambil Prerequisites (Zone, Gate, Vehicle Type, RFID)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Pastikan token sudah ada sebelum lanjut",
                  "const token = pm.collectionVariables.get('token');",
                  "if (!token) {",
                  "  throw new Error('❌ Token kosong! Jalankan request Login dulu.');",
                  "}"
                ],
                "id": "dd6f92e0-bde9-4ef3-a49b-0f177619fe11"
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Request ini hanya sebagai trigger — logic ada di pre-request folder-level",
                  "// Semua variable di-set lewat pm.sendRequest di bawah",
                  "",
                  "const base  = pm.collectionVariables.get('baseUrl');",
                  "const auth  = { Authorization: 'Bearer ' + pm.collectionVariables.get('token') };",
                  "",
                  "// 1. Ambil zone aktif",
                  "pm.sendRequest({ url: base + '/zones?active=true&page=1&page_size=5', method: 'GET', header: auth },",
                  "  (err, zonesRes) => {",
                  "    if (err) { console.error('Gagal ambil zones:', err); return; }",
                  "    const zones = zonesRes.json().data;",
                  "    if (!zones || !zones.length) { console.error('❌ Tidak ada zone aktif'); return; }",
                  "",
                  "    const zone = zones[0];",
                  "    pm.collectionVariables.set('zone_id', zone.id);",
                  "    console.log('zone_id:', zone.id, '|', zone.name);",
                  "",
                  "    // 2. Ambil gates dari zone",
                  "    pm.sendRequest({ url: `${base}/zones/${zone.id}/gates?active=true&page_size=20`, method: 'GET', header: auth },",
                  "      (err2, gatesRes) => {",
                  "        if (err2) { console.error('Gagal ambil gates:', err2); return; }",
                  "        const gates = gatesRes.json().data || [];",
                  "        const entry = gates.find(g => g.gate_type === 'entry');",
                  "        const exit  = gates.find(g => g.gate_type === 'exit');",
                  "",
                  "        if (entry) {",
                  "          pm.collectionVariables.set('entry_gate_id', entry.id);",
                  "          console.log('entry_gate_id:', entry.id, '|', entry.name);",
                  "        } else {",
                  "          console.error('❌ Tidak ada entry gate aktif di zone ini');",
                  "        }",
                  "        if (exit) {",
                  "          pm.collectionVariables.set('exit_gate_id', exit.id);",
                  "          console.log('exit_gate_id:', exit.id, '|', exit.name);",
                  "        } else {",
                  "          console.error('❌ Tidak ada exit gate aktif di zone ini');",
                  "        }",
                  "      }",
                  "    );",
                  "  }",
                  ");",
                  "",
                  "// 3. Ambil vehicle type",
                  "pm.sendRequest({ url: base + '/vehicle-types?page=1&page_size=5', method: 'GET', header: auth },",
                  "  (err, vtRes) => {",
                  "    if (err) { console.error('Gagal ambil vehicle types:', err); return; }",
                  "    const vt = vtRes.json().data;",
                  "    if (vt && vt.length) {",
                  "      pm.collectionVariables.set('vehicle_type_id', vt[0].id);",
                  "      console.log('vehicle_type_id:', vt[0].id, '|', vt[0].name);",
                  "    } else {",
                  "      console.error('❌ Tidak ada vehicle type');",
                  "    }",
                  "  }",
                  ");",
                  "",
                  "// 4. Cek / daftarkan RFID card untuk test",
                  "const rfidUID = pm.collectionVariables.get('rfid_card_uid');",
                  "pm.sendRequest({",
                  "  url: base + '/rfid/cards',",
                  "  method: 'POST',",
                  "  header: { ...auth, 'Content-Type': 'application/json' },",
                  "  body: { mode: 'raw', raw: JSON.stringify({ card_uid: rfidUID }) }",
                  "}, (err, rfidRes) => {",
                  "  if (err) { console.error('Gagal register RFID:', err); return; }",
                  "  const status = rfidRes.code;",
                  "  if (status === 201) {",
                  "    console.log('✅ RFID card baru didaftarkan:', rfidUID);",
                  "  } else if (status === 409) {",
                  "    console.log('ℹ️ RFID card sudah ada (409), lanjut pakai yang existing');",
                  "  } else {",
                  "    console.warn('RFID register response:', status, rfidRes.text());",
                  "  }",
                  "});"
                ],
                "id": "29190d1a-8d1d-44f7-aa53-5ace7e567c21"
              }
            }
          ],
          "id": "9cb2908a-ef8d-48f4-80e1-556c1c2a9baf",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/zones?active=true&page=1&page_size=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "zones"
              ],
              "query": [
                {
                  "key": "active",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "1"
                }
              ]
            },
            "description": "Request ini memicu pre-request script yang mengambil zone, gates, vehicle type, dan mendaftarkan RFID card sekaligus. Cek Console untuk log hasilnya."
          },
          "response": []
        }
      ],
      "id": "03aaf9e9-0cc5-4f49-b4ad-89f689879172"
