    {
      "name": "📸 Entry dengan Foto (OCR Trigger)",
      "item": [
        {
          "name": "Entry RFID + Foto (OCR akan jalan async)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guard: pastikan prerequisite sudah di-set",
                  "const required = ['token', 'entry_gate_id', 'rfid_card_uid'];",
                  "required.forEach(key => {",
                  "  const val = pm.collectionVariables.get(key);",
                  "  if (!val) throw new Error(`❌ Variable '${key}' belum di-set. Jalankan Setup dulu.`);",
                  "});"
                ],
                "id": "65ecdb5e-977c-49eb-b58d-25e271d540b5"
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 - Entry berhasil', () => pm.response.to.have.status(201));",
                  "",
                  "const d = pm.response.json().data;",
                  "",
                  "pm.test('Status transaksi = open', () => pm.expect(d.status).to.eql('open'));",
                  "pm.test('Entry method = rfid', () => pm.expect(d.entry_method).to.eql('rfid'));",
                  "pm.test('Transaction code format PKR-YYYYMMDD-NNNNN', () =>",
                  "  pm.expect(d.transaction_code).to.match(/^PKR-\\d{8}-\\d{5}$/)",
                  ");",
                  "pm.test('rfid_card_id ada', () => pm.expect(d.rfid_card_id).to.be.a('string'));",
                  "pm.test('zone_id ada', () => pm.expect(d.zone_id).to.be.a('string'));",
                  "",
                  "// Simpan tx_id untuk request selanjutnya",
                  "pm.collectionVariables.set('tx_id', d.id);",
                  "console.log('✅ tx_id tersimpan:', d.id);",
                  "console.log('ℹ️ OCR job akan berjalan async di background — vehicle_id akan terisi setelah OCR selesai');"
                ],
                "id": "6ce50793-1ec5-4eb9-ac52-1440029d9160"
              }
            }
