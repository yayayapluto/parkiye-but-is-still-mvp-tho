      "name": "🚗 Exit dengan Foto (OCR + Plate Match)",
      "item": [
        {
          "name": "Exit RFID + Foto (plate match akan dicek)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const required = ['token', 'tx_id', 'exit_gate_id', 'rfid_card_uid', 'vehicle_type_id'];",
                  "required.forEach(key => {",
                  "  if (!pm.collectionVariables.get(key))",
                  "    throw new Error(`❌ '${key}' belum di-set. Jalankan Setup dan Entry dulu.`);",
                  "});"
                ],
                "id": "8fe76b0e-1f5a-4a84-b5b7-be35a61bb371"
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 - Exit berhasil', () => pm.response.to.have.status(200));",
                  "",
                  "const d = pm.response.json().data;",
                  "",
                  "pm.test('Status = awaiting_payment', () => pm.expect(d.status).to.eql('awaiting_payment'));",
                  "pm.test('calculated_fee ada dan number', () => pm.expect(d.calculated_fee).to.be.a('number'));",
                  "pm.test('calculated_fee >= 0', () => pm.expect(d.calculated_fee).to.be.at.least(0));",
                  "pm.test('exit_at ada', () => pm.expect(d.exit_at).to.exist);",
                  "pm.test('exit_gate_id ada', () => pm.expect(d.exit_gate_id).to.be.a('string'));",
                  "",
                  "console.log('💰 calculated_fee:', d.calculated_fee);",
                  "console.log('ℹ️ OCR exit akan berjalan async — auto_match_result akan diisi di ocr_review_logs');"
                ],
                "id": "c02a6a56-dee5-4856-8f19-9aa13aa38216"
              }
            }
