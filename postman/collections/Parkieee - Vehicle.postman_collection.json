      "name": "1. Vehicle Types",
      "item": [
        {
          "name": "List Vehicle Types - success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('returns seeded types', () => {",
                  "  const data = pm.response.json().data;",
                  "  pm.expect(data).to.be.an('array').with.lengthOf.at.least(3);",
                  "  const names = data.map(d => d.name);",
                  "  pm.expect(names).to.include.members(['motorcycle', 'car', 'truck']);",
                  "  pm.collectionVariables.set('vtype_id', data[0].id);",
                  "});"
                ],
                "type": "text/javascript",
                "id": "0d465903-e749-448f-b4a6-1116aa95ae99"
              }
            }
          ],
