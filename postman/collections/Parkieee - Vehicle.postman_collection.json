          "name": "Upsert Vehicle - success (create)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('vehicle created', () => {",
                  "  const d = pm.response.json().data;",
                  "  pm.expect(d.plate_number).to.eql('B1234ABC');",
                  "  pm.expect(d.source).to.eql('manual_override');",
                  "  pm.expect(d.vehicle_type).to.be.an('object');",
                  "  pm.collectionVariables.set('vehicle_id', d.id);",
                  "});"
