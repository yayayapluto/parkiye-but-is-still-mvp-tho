        {
          "name": "Create Fee Config - Happy Path",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Deactivate any existing active fee config for this zone+vehicle_type combo",
                  "// to avoid hitting the partial unique constraint uidx_fee_configs_zone_vtype_active.",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "const token = pm.collectionVariables.get('token');",
                  "const zoneId = pm.collectionVariables.get('zoneId');",
                  "const vehicleTypeId = pm.collectionVariables.get('vehicleTypeId');",
                  "",
                  "pm.sendRequest({",
                  "  url: `${baseUrl}/fee/configs?zone_id=${zoneId}&vehicle_type_id=${vehicleTypeId}&page=1&page_size=50`,",
                  "  method: 'GET',",
                  "  header: { Authorization: `Bearer ${token}` }",
                  "}, (err, res) => {",
                  "  if (err || res.code !== 200) return;",
                  "  const configs = res.json().data || [];",
                  "  configs.filter(c => c.is_active).forEach(c => {",
                  "    pm.sendRequest({",
                  "      url: `${baseUrl}/fee/configs/${c.id}`,",
                  "      method: 'DELETE',",
                  "      header: { Authorization: `Bearer ${token}` }",
                  "    }, () => {});",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.test('id ada', () => pm.expect(d.id).to.be.a('string'));",
                  "pm.test('is_active true', () => pm.expect(d.is_active).to.be.true);",
                  "pm.test('tiers ada', () => pm.expect(d.tiers).to.be.an('array').with.lengthOf(2));",
                  "pm.collectionVariables.set('feeConfigId', d.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
