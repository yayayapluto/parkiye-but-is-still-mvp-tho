                  "const d = pm.response.json().data;",
                  "pm.test('method cash', () => pm.expect(d.method).to.eql('cash'));",
                  "pm.test('status completed', () => pm.expect(d.status).to.eql('completed'));",
                  "pm.test('cash_tendered ada', () => pm.expect(d.cash_tendered).to.be.a('number'));",
                  "pm.test('cash_change ada', () => pm.expect(d.cash_change).to.be.a('number'));",
                  "pm.test('cash_change = tendered - amount', () => pm.expect(d.cash_change).to.eql(d.cash_tendered - d.amount));",
                  "pm.test('paid_at ada', () => pm.expect(d.paid_at).to.exist);",
