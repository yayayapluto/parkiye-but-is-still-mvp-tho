    {
      "name": "1. [Setup] Siapkan transaksi awaiting_payment (entry → exit)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const base  = pm.collectionVariables.get('baseUrl');",
              "const auth  = { Authorization: 'Bearer ' + pm.collectionVariables.get('token'), 'Content-Type': 'application/json' };",
              "",
              "pm.sendRequest({ url: base + '/zones?page=1&page_size=50', method: 'GET', header: auth },",
              "  (err, zonesRes) => {",
              "    const zones = zonesRes.json().data || [];",
              "    const zone = zones.find(z => z.name === 'Parkir Motor') || zones[0];",
              "    if (!zone) { console.error('NO ZONE FOUND'); return; }",
              "    pm.collectionVariables.set('zoneId', zone.id);",
              "",
              "    pm.sendRequest({ url: `${base}/zones/${zone.id}/gates?active=true&page=1&page_size=20`, method: 'GET', header: auth },",
              "      (err2, gatesRes) => {",
              "        const gates = gatesRes.json().data || [];",
              "        const entryGate = gates.find(g => g.gate_type === 'entry');",
              "        const exitGate  = gates.find(g => g.gate_type === 'exit');",
              "        if (!entryGate || !exitGate) { console.error('GATES NOT FOUND'); return; }",
              "        pm.collectionVariables.set('entryGateId', entryGate.id);",
              "        pm.collectionVariables.set('exitGateId', exitGate.id);",
              "",
              "        pm.sendRequest({ url: base + '/vehicle-types', method: 'GET', header: auth },",
              "          (err3, vtRes) => {",
              "            const vts = vtRes.json().data || [];",
              "            const moto = vts.find(v => v.name === 'motorcycle') || vts[0];",
              "            if (!moto) { console.error('NO VEHICLE TYPE'); return; }",
              "            pm.collectionVariables.set('vehicleTypeId', moto.id);",
              "",
              "            const uid = 'PY:' + Date.now().toString(16).toUpperCase().slice(-6).match(/../g).join(':');",
              "            pm.collectionVariables.set('rfidUid', uid);",
              "            pm.sendRequest({",
              "              url: base + '/rfid/cards', method: 'POST', header: auth,",
              "              body: { mode: 'raw', raw: JSON.stringify({ card_uid: uid }) }",
              "            }, (err4, rfidRes) => {",
              "              if (rfidRes.code !== 201) { console.error('RFID REG FAILED', rfidRes.text()); return; }",
              "",
              "              pm.sendRequest({",
              "                url: base + '/transactions/entry', method: 'POST', header: auth,",
              "                body: { mode: 'raw', raw: JSON.stringify({",
              "                  entry_gate_id: entryGate.id,",
              "                  entry_method: 'rfid',",
              "                  rfid_card_uid: uid",
              "                })}",
              "              }, (err5, entryRes) => {",
              "                if (entryRes.code !== 201) { console.error('ENTRY FAILED', entryRes.text()); return; }",
              "                const tx = entryRes.json().data;",
              "                pm.collectionVariables.set('txId', tx.id);",
              "",
              "                pm.sendRequest({",
              "                  url: `${base}/transactions/${tx.id}/exit`, method: 'POST', header: auth,",
              "                  body: { mode: 'raw', raw: JSON.stringify({",
              "                    exit_gate_id: exitGate.id,",
              "                    exit_method: 'rfid',",
              "                    rfid_card_uid: uid,",
              "                    vehicle_type_id: moto.id",
              "                  })}",
              "                }, (err6, exitRes) => {",
              "                  if (exitRes.code !== 200) { console.error('EXIT FAILED', exitRes.text()); return; }",
              "                  const txAfterExit = exitRes.json().data;",
              "                  pm.collectionVariables.set('calculatedFee', txAfterExit.calculated_fee);",
              "                  console.log('Setup done. txId:', tx.id, 'fee:', txAfterExit.calculated_fee);",
              "                });",
              "              });",
              "            });",
              "          }",
              "        );",
              "      }",
              "    );",
              "  }",
              ");"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('txId tersimpan', () => pm.expect(pm.collectionVariables.get('txId')).to.be.a('string').and.not.empty);",
              "pm.test('entryGateId tersimpan', () => pm.expect(pm.collectionVariables.get('entryGateId')).to.be.a('string').and.not.empty);",
              "pm.test('exitGateId tersimpan', () => pm.expect(pm.collectionVariables.get('exitGateId')).to.be.a('string').and.not.empty);"
            ],
            "type": "text/javascript"
          }
        }
      ],
