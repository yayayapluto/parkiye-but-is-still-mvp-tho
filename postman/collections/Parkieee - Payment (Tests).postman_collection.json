        {
          "name": "Request Refund - refund_amount melebihi payment amount → 400",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const base = pm.collectionVariables.get('baseUrl');",
                  "const auth = { Authorization: 'Bearer ' + pm.collectionVariables.get('token'), 'Content-Type': 'application/json' };",
                  "const uid = 'RX:' + Date.now().toString(16).toUpperCase().slice(-6).match(/../g).join(':');",
                  "const entryGateId = pm.collectionVariables.get('entryGateId');",
                  "const exitGateId  = pm.collectionVariables.get('exitGateId');",
                  "const vtId        = pm.collectionVariables.get('vehicleTypeId');",
                  "pm.sendRequest({ url: base + '/rfid/cards', method: 'POST', header: auth,",
                  "  body: { mode: 'raw', raw: JSON.stringify({ card_uid: uid }) }",
                  "}, () => {",
                  "  pm.sendRequest({ url: base + '/transactions/entry', method: 'POST', header: auth,",
                  "    body: { mode: 'raw', raw: JSON.stringify({ entry_gate_id: entryGateId, entry_method: 'rfid', rfid_card_uid: uid }) }",
                  "  }, (e2, entryRes) => {",
                  "    const txId = entryRes.json().data.id;",
                  "    pm.sendRequest({ url: `${base}/transactions/${txId}/exit`, method: 'POST', header: auth,",
                  "      body: { mode: 'raw', raw: JSON.stringify({ exit_gate_id: exitGateId, exit_method: 'rfid', rfid_card_uid: uid, vehicle_type_id: vtId }) }",
                  "    }, () => {",
                  "      pm.sendRequest({ url: base + '/payments/cash', method: 'POST', header: auth,",
                  "        body: { mode: 'raw', raw: JSON.stringify({ transaction_id: txId, cash_tendered: 50000 }) }",
                  "      }, (e4, payRes) => {",
                  "        pm.collectionVariables.set('paymentIdForRefundTest', payRes.json().data.id);",
                  "      });",
                  "    });",
                  "  });",
                  "});"
                ],
                "type": "text/javascript"
              }
