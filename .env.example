# Application
APP_NAME=parkieee
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080
PLACE_NAME=SMKS Taruna Bhakti Depok
QR_SECRET=ganti-dengan-secret-panjang-random-di-production

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s
SERVER_PRINT_ROUTES=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=parkieee
DB_SSLMODE=disable
DB_LOG_LEVEL=warn
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SECONDS=300
DB_CONN_MAX_IDLE_TIME_SECONDS=60

# JWT
JWT_SECRET_KEY=parkieee-dev-secret-key-ganti-di-production-min32
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# ── Observability ───────────────────────────────────────────────
# Enable/disable tracing (set to false in development if not needed)
ENABLE_TRACING=true

# Grafana
GRAFANA_PASSWORD=admin

# Observability service ports
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100

# Log level for observability (debug/info/warn/error)
OBSERVABILITY_LOG_LEVEL=info

# Logging
LOG_LEVEL=info
LOG_ADD_SOURCE=false
LOG_JSON_FORMAT=true
LOG_OUTPUT_PATHS=stdout,storage/logs/app.log
LOG_FILE_MAX_SIZE=100
LOG_FILE_MAX_BACKUPS=3
LOG_FILE_MAX_AGE=28
LOG_FILE_COMPRESS=true

TEMPO_PORT=4318

OCR_ENABLED=true
OCR_API_URL=http://python-ocr:8000
OCR_TIMEOUT=15s
OCR_MAX_RETRIES=2
OCR_AUTO_ACCEPT_THRESHOLD=0.80
# Default vehicle type for OCR is configured per-zone via the for_vehicle_type_id field.
# Set it when creating/updating a zone: POST /api/v1/zones { "for_vehicle_type_id": "<uuid>" }